# Ports are configured in dmw.conf at the repo root. Setting PORT here overrides it.
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@dmw.local
ADMIN_PASSWORD=admin123
DB_PATH=./data/dmw.db

# Secure flag for the refresh-token cookie. Defaults to true when NODE_ENV=production,
# false otherwise. Set explicitly (true/false) to override the default.
COOKIE_SECURE=

# Wake-on-LAN
# Leave empty to derive the broadcast address from the device IP (assumes /24).
# Set an explicit address when the LAN uses a different prefix.
WOL_BROADCAST_ADDRESS=

# CORS
# Optional in development - http://localhost:5173 and http://127.0.0.1:5173 are always
# allowed automatically. Set to allow additional origins (comma-separated, e.g.
# CORS_ORIGIN=http://localhost:3000,http://192.168.0.10:5173). FRONTEND_ORIGIN also works
# as an alias for this variable.
CORS_ORIGIN=

# Monitoring alerts
ALERT_CPU_THRESHOLD=85
ALERT_MEMORY_THRESHOLD=80
ALERT_DISK_THRESHOLD=90
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Production note:
# - Replace admin password before deployment.
# - Generate a strong JWT_SECRET value for production.
# - Keep .env out of source control.
