PORT=3001
JWT_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@dmw.local
ADMIN_PASSWORD=replace-with-strong-password
DB_PATH=/app/data/dmw.db

# Secure flag for the refresh-token cookie. Defaults to true when NODE_ENV=production;
# set explicitly to make the production requirement unambiguous.
COOKIE_SECURE=true

# Leave empty to derive the broadcast address from the device IP (assumes /24).
WOL_BROADCAST_ADDRESS=

# Required in production. Comma-separated list of allowed origins, including protocol
# (e.g. CORS_ORIGIN=https://example.com,https://app.example.com). FRONTEND_ORIGIN also
# works as an alias for this variable. Server will fail to start in production without it.
CORS_ORIGIN=https://example.com

ALERT_CPU_THRESHOLD=85
ALERT_MEMORY_THRESHOLD=80
ALERT_DISK_THRESHOLD=90
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security notes:
# - Do not commit this file to git.
# - Use a unique JWT secret per environment.
# - Keep admin password different from local development values.
