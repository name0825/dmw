# docker compose(docker-compose.yml, docker-compose.https.yml)에서 참조하는 환경변수.
# 이 파일을 .env로 복사한 뒤 값을 채워서 사용한다.

# 서버 인증
# JWT 서명에 사용하는 비밀키. 운영 환경에서는 반드시 강력한 값으로 교체할 것.
JWT_SECRET=change-me-in-production
# 관리자 계정. 운영 배포 전 비밀번호를 반드시 교체할 것.
ADMIN_EMAIL=admin@dmw.local
ADMIN_PASSWORD=change-me-in-production

# CORS 허용 origin (쉼표로 구분). 비워두면 localhost/127.0.0.1의 WEB_DEV_PORT만 허용.
CORS_ORIGIN=

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 웹(nginx) 빌드/런타임 포트
# 프런트엔드 빌드 시 API/WS 베이스 URL을 강제로 지정할 때만 설정 (보통 비워두면 페이지 호스트 기준으로 계산됨).
VITE_API_BASE=
VITE_WS_BASE=
# 백엔드 API/WS 포트 (web 컨테이너가 nginx 프록시 설정을 빌드할 때 참조)
SERVER_PORT=3001
WS_PORT=3002
# nginx가 HTTP로 서비스하는 포트
WEB_DEV_PORT=5173
# nginx가 HTTPS로 서비스하는 포트 (docker-compose.https.yml 사용 시)
WEB_HTTPS_PORT=8443
